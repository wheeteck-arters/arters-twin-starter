# Copy this file to .env and fill in your keys. Never commit .env.
# On Railway, set these as Variables instead.

# Claude writes the Twin's answers and drafts. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
# Model for the Twin. Leave as is unless your instructor says otherwise.
TWIN_MODEL=claude-opus-5-5

# Gemini makes the search embeddings and topic tags. Free key at aistudio.google.com
GEMINI_API_KEY=
# Optional: leave empty to use the newest Gemini Flash model automatically
GEMINI_MODEL=

# Your details, shown on the site
TWIN_NAME=Your Name
TWIN_HEADLINE=What you do, in one line
TWIN_LOCATION=Singapore

# Safety switches for the public site
RATE_LIMIT_PER_MINUTE=6
DAILY_QUESTION_CAP=150
PORT=3000
